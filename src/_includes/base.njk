<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@300;400;500;600&family=Azeret+Mono:wght@400;500&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    // Inline so the right theme is applied before first paint (no flash).
    (function () {
      try {
        var stored = localStorage.getItem("vow-theme");
        var prefersLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
        var theme = stored || (prefersLight ? "light" : "dark");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  {{ content | safe }}
  <script>
    (function () {
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var cur = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        var next = cur === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("vow-theme", next); } catch (e) {}
      });

      document.querySelectorAll("[data-copy]").forEach(function (el) {
        el.addEventListener("click", function () {
          var target = document.getElementById(el.getAttribute("data-copy"));
          if (!target) return;
          var text = target.innerText.replace(/^\$\s*/gm, "");
          navigator.clipboard.writeText(text).then(function () {
            var prev = el.getAttribute("aria-label");
            el.setAttribute("aria-label", "Copied");
            el.classList.add("is-copied");
            setTimeout(function () {
              el.setAttribute("aria-label", prev || "Copy");
              el.classList.remove("is-copied");
            }, 1400);
          });
        });
      });
    })();
  </script>
</body>
</html>
